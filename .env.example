# PostgreSQL connection string.
# Neon:     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Supabase: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/task_manager?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# On Railway, leave DATABASE_URL as-is and run commands through `railway run`,
# which injects the service's own DATABASE_URL over this one.
#
# Behind PgBouncer (Neon/Supabase pooled hosts), `prisma migrate` needs a direct
# connection. Add DIRECT_URL here and `directUrl = env("DIRECT_URL")` to the
# datasource block in prisma/schema.prisma.

# Optional read cache. Leave unset and the app reads straight from PostgreSQL.
# On Railway: REDIS_URL = ${{Redis.REDIS_URL}}
# REDIS_URL="redis://localhost:6379"
