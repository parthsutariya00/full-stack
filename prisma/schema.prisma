generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled host cannot hold the advisory lock `prisma migrate` takes.
  // DIRECT_URL is the same connection string with `-pooler` removed.
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  color       String   @default("#6366f1") @db.VarChar(9)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([createdAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(140)
  description String?      @db.VarChar(1000)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  attachments TaskAttachment[]

  @@index([projectId, status])
  @@index([dueDate])
}

/// One image stored in Cloudflare R2. The row is the index; `key` is the only
/// pointer into the bucket, and the bytes never pass through this app.
model TaskAttachment {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(400)
  filename    String   @db.VarChar(200)
  contentType String   @db.VarChar(100)
  size        Int
  createdAt   DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
